# StableCard Rail — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Phases 1-2 use the "core", "webhooks" and "issuers" sections. Later phases
# append their own (Lithic, Stripe, Solana, bridge, Fireblocks) — each variable is
# documented here before it is read anywhere in the code.

# ---------------------------------------------------------------- core ------
# Free-form deployment label; used for log context only.
ENVIRONMENT=local

# SQLAlchemy async URL for the application database.
# Host port 5442 is what docker-compose publishes (5432 is often taken locally).
DATABASE_URL=postgresql+asyncpg://stablecard:stablecard@localhost:5442/stablecard

# Database used by the test suite. Created automatically by tests if absent.
# Must NOT point at the application database — the suite truncates tables.
TEST_DATABASE_URL=postgresql+asyncpg://stablecard:stablecard@localhost:5442/stablecard_test

# Redis: webhook dedup claims, the handler retry queue, the EventBus stream, and
# from phase 7 OTP codes.
REDIS_URL=redis://localhost:6389/0

# Redis database used by the test suite. The suite FLUSHES this database, so it
# must never point at the application's. Derived from REDIS_URL (db 15) if unset.
TEST_REDIS_URL=redis://localhost:6389/15

# Python logging level for the backend.
LOG_LEVEL=INFO

# ISO-4217 currency assumed when a caller does not specify one.
DEFAULT_CURRENCY=USD

# ------------------------------------------------------------ webhooks ------
# How long a (provider_id, event_id) dedup claim is kept in Redis. The ledger's
# unique index takes over once it expires, so this is a cache size, not a
# correctness knob. Default: 86400 (one day).
WEBHOOK_DEDUP_TTL_SECONDS=86400

# Delay before each successive handler retry, as a JSON list. Its length is the
# retry cap: a handler that exhausts it is dead-lettered.
WEBHOOK_RETRY_BACKOFF_SECONDS=[2,8,32,128,512]

# ------------------------------------------------------------- issuers ------
# Everything below is declared by the adapter that reads it — one settings class
# per provider, under that provider's env prefix (app/issuers/<name>/config.py).
# `app/core/config.py` deliberately holds no provider fields: a `lithic_api_key`
# there made "adding an issuer is one adapter file plus one registry entry" false,
# and left a dead EVM_DEPOSIT_MOCK_WEBHOOK_SECRET behind when that adapter was
# replaced. Two tests in backend/tests/test_module_boundaries.py now enforce it.
#
# The signature receiving window is part of this: it belongs to whoever owns a
# signing scheme, so there is one per adapter rather than one global
# WEBHOOK_SIGNATURE_TOLERANCE_SECONDS.

# ------------------------------------------------ gnosis_pay_mock (§3.2) -----
# The in-process mock crypto-deposit provider. No credentials: the "provider" is
# a simulator inside this repo, and it signs its own webhooks with a keypair it
# derives from a constant in the code — so there is nothing here to leak.
#
# Rejection window for a delivery's signature timestamp, in seconds, in either
# direction, so a captured delivery cannot be replayed indefinitely.
GNOSIS_PAY_MOCK_SIGNATURE_TOLERANCE_SECONDS=300

# -------------------------------------------------------- lithic (§3.2) -----
# Lithic sandbox. Sign up at lithic.com/signup; the sandbox key is issued with the
# account (app.lithic.com/settings). Leave LITHIC_API_KEY empty and the adapter
# refuses to build — nothing else in the service is affected.
#
# The test suite never calls this API: contract tests replay recorded fixtures in
# backend/tests/fixtures/lithic/, regenerated by
# `python scripts/record_lithic_fixtures.py`.
LITHIC_API_BASE_URL=https://sandbox.lithic.com/v1
LITHIC_API_KEY=

# Per-program webhook signing secret, in Lithic's `whsec_<base64>` form. Obtained
# by creating an event subscription and then reading
# GET /v1/event_subscriptions/{token}/secret. Only needed to accept genuine
# inbound deliveries — signature tests sign their own bodies.
LITHIC_WEBHOOK_SECRET=

# Per-request timeout, in seconds, for calls to Lithic.
LITHIC_REQUEST_TIMEOUT_SECONDS=15.0

# Rejection window for a Lithic delivery's signature timestamp, in seconds.
LITHIC_SIGNATURE_TOLERANCE_SECONDS=300

# ------------------------------------------------ stripe_issuing (§3.2) -----
# Stripe Issuing test mode. Create an account at dashboard.stripe.com, select
# "Card issuing" during onboarding, then activate Issuing
# (dashboard.stripe.com/issuing/overview) — until you do, every /v1/issuing/* call is
# a 400 and nothing else here matters.
#
# Then add test funds to the **Issuing** balance, which is not the payments balance:
# Dashboard -> Issuing -> Balance -> Add funds credits instantly. Via the API,
# `POST /v1/topups` with `destination_balance=issuing` is accepted but stays `pending`
# in test mode, and `/v1/test_helpers/issuing/fund_balance` is for UK/EU
# funding-instruction accounts only. With a zero balance every simulated authorization
# is declined `insufficient_funds`.
#
# `python scripts/record_stripe_fixtures.py --preflight` checks all three and tells you
# which one is missing.
#
# Note the prefix: these are STRIPE_ISSUING_*, not STRIPE_*, because the env prefix
# is the adapter package's own name (app/issuers/stripe_issuing/config.py). A
# future `stripe_connect` adapter would get its own, and neither would read the
# other's variables. backend/tests/test_module_boundaries.py enforces that.
#
# Unlike Lithic, an empty key does not stop the adapter from being built: `GET
# /providers` calls registry.describe(), which instantiates every registered
# adapter, so a missing Stripe key must not take that endpoint down for the
# providers that are configured. The failure happens on the first call that needs
# the key, and names this variable.
#
# The test suite never calls this API. Its fixtures in
# backend/tests/fixtures/stripe_issuing/ are recorded from a real test-mode account by
# `python scripts/record_stripe_fixtures.py`; the README there says which files are
# recorded, which are derived, and which are still authored from documentation.
STRIPE_ISSUING_API_BASE_URL=https://api.stripe.com/v1

# Secret key, from Developers -> API keys. **Must be a test key.** Stripe reads
# test-vs-live from the key rather than from the host, so there is no sandbox URL
# standing between a misconfiguration and real money — the adapter refuses any key
# containing `_live_` outright (SPEC.md §2: sandboxes only).
STRIPE_ISSUING_API_KEY=

# Endpoint signing secret, in Stripe's `whsec_...` form. From a Dashboard webhook
# endpoint, or more easily
# `stripe listen --forward-to localhost:8000/webhooks/stripe_issuing`, which prints
# one for the session. Note that Stripe keys its HMAC on this string *exactly as
# issued*, `whsec_` prefix included — unlike Lithic, which base64-decodes what
# follows the prefix. Leave empty and deliveries are refused rather than trusted.
STRIPE_ISSUING_WEBHOOK_SECRET=

# Pins the `Stripe-Version` header when set; empty means the account's own default.
# Left empty deliberately: the only version-dependent behaviour this adapter cares
# about is whether a lapsed authorization reports `expired` or `reversed`, and it
# treats both as a reversal.
STRIPE_ISSUING_API_VERSION=

# Per-request timeout, in seconds, for calls to Stripe.
STRIPE_ISSUING_REQUEST_TIMEOUT_SECONDS=15.0

# Rejection window for a Stripe delivery's signature timestamp, in seconds.
# Stripe's own libraries default to 300.
STRIPE_ISSUING_SIGNATURE_TOLERANCE_SECONDS=300

# ------------------------------------------------------ docker-compose ------
# Consumed by docker-compose.yml interpolation, not by the app.
POSTGRES_USER=stablecard
POSTGRES_PASSWORD=stablecard
POSTGRES_DB=stablecard
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
BACKEND_HOST_PORT=8000
