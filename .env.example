# StableCard Rail — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Phases 1-2 use the "core", "webhooks" and "issuers" sections. Later phases
# append their own (Lithic, Stripe, Solana, bridge, Fireblocks) — each variable is
# documented here before it is read anywhere in the code.

# ---------------------------------------------------------------- core ------
# Free-form deployment label; used for log context only.
ENVIRONMENT=local

# SQLAlchemy async URL for the application database.
# Host port 5442 is what docker-compose publishes (5432 is often taken locally).
DATABASE_URL=postgresql+asyncpg://stablecard:stablecard@localhost:5442/stablecard

# Database used by the test suite. Created automatically by tests if absent.
# Must NOT point at the application database — the suite truncates tables.
TEST_DATABASE_URL=postgresql+asyncpg://stablecard:stablecard@localhost:5442/stablecard_test

# Redis: webhook dedup claims, the handler retry queue, the EventBus stream, and
# from phase 7 OTP codes.
REDIS_URL=redis://localhost:6389/0

# Redis database used by the test suite. The suite FLUSHES this database, so it
# must never point at the application's. Derived from REDIS_URL (db 15) if unset.
TEST_REDIS_URL=redis://localhost:6389/15

# Python logging level for the backend.
LOG_LEVEL=INFO

# ISO-4217 currency assumed when a caller does not specify one.
DEFAULT_CURRENCY=USD

# ------------------------------------------------------------ webhooks ------
# How long a (provider_id, event_id) dedup claim is kept in Redis. The ledger's
# unique index takes over once it expires, so this is a cache size, not a
# correctness knob. Default: 86400 (one day).
WEBHOOK_DEDUP_TTL_SECONDS=86400

# Delay before each successive handler retry, as a JSON list. Its length is the
# retry cap: a handler that exhausts it is dead-lettered.
WEBHOOK_RETRY_BACKOFF_SECONDS=[2,8,32,128,512]

# ------------------------------------------ funding engine (§5.2, §5.3) -----
# The auto top-up engine and the reconciler. Both are ours, not a provider's, so
# they live in app/core/config.py rather than in a component's own settings.

# Self-transitions allowed per state before an intent is marked FAILED_*. The
# count lives on the intent row, so the cap survives a restart.
FUNDING_MAX_RETRIES=5

# The route the bridge is asked for. Opaque labels a bridge either supports or
# does not — deliberately not an enum of chains.
FUNDING_SOURCE_CHAIN=solana-devnet
FUNDING_DESTINATION_CHAIN=gnosis-chiado

# Where a bridge order is delivered when the issuer is a *fiat rail* (Lithic,
# Stripe) and so has no on-chain address of its own. A crypto-deposit issuer's
# card supplies its own — see docs/ARCHITECTURE.md §9.3. Not a secret; an
# address. Left empty here: with no value, an intent at a fiat-rail issuer fails
# with a message naming this variable rather than sending money nowhere.
FUNDING_SETTLEMENT_ADDRESS=

# How long an intent's state must be unchanged before the reconciler treats it as
# stuck (SPEC.md §5.3). Also the base of the backoff: an intent is not eligible
# again until it has been quiet for this many seconds doubled per retry.
RECONCILER_STUCK_AFTER_SECONDS=120

# Ceiling on that doubling, so a much-retried intent is still looked at.
RECONCILER_MAX_BACKOFF_SECONDS=3600

# Intents examined per reconciler pass. A pass is a batch, not a queue drain.
RECONCILER_BATCH_LIMIT=50

# How long a hop is left alone before its *first* attempt, in seconds. Not zero:
# whichever process created the intent is probably about to step it, and a worker
# racing that only contends on the row lock. Retries are not governed by this —
# they are paced by the reconciler's backoff above.
WORKER_FIRST_ATTEMPT_AFTER_SECONDS=3.0

# Seconds between passes when `scripts/run_funding_worker.py` runs as a loop
# rather than with --once.
WORKER_INTERVAL_SECONDS=5.0

# ---------------------------------------------- 3DS / OTP service (§6) ------
# One short-lived secret and the two ways an app is told about it. Nothing here is
# a credential: the code is generated per challenge and is never in a file.

# How long a challenge is remembered when the provider does not date one. Only a
# fallback — an `expiry_time` the provider *does* send always wins, because a code
# that outlives its challenge is one the cardholder enters and is declined for.
OTP_TTL_SECONDS=300

# And the ceiling, whatever the provider says. A backstop against a payload
# claiming the challenge lives for a week, not a policy about challenge length:
# keep it above any real provider's deadline (Lithic's are ~10 minutes).
OTP_MAX_TTL_SECONDS=900

# Digits in a code we mint ourselves — which is what happens for a provider whose
# 3DS flow makes the card program the party that issues the challenge. Six is what
# every SMS-OTP flow uses, so it is what a cardholder expects to be asked for.
OTP_CODE_DIGITS=6

# ------------------------------------------------- card reveal (§9.2) -------
# The PSE-style reveal: the backend mints a short-lived single-use token, the app
# exchanges it for the card's details. No credential here either — the token is
# generated per request, stored only as a hash, and worthless at the provider.

# Lifetime of the token we mint. Sixty seconds because that is what Gnosis Pay's
# own ephemeral token gets, and this models theirs: a longer one would be a bearer
# credential outliving the provider credential it stands in for.
REVEAL_TOKEN_TTL_SECONDS=60

# How long a spent token is remembered *as spent*, so a replay reads as a replay
# in the ledger instead of as an unknown token. Never changes what a client is
# told — a replayed token and a guessed one both answer 404.
REVEAL_REPLAY_MEMORY_SECONDS=900

# ------------------------------------------------------------- issuers ------
# Everything below is declared by the adapter that reads it — one settings class
# per provider, under that provider's env prefix (app/issuers/<name>/config.py).
# `app/core/config.py` deliberately holds no provider fields: a `lithic_api_key`
# there made "adding an issuer is one adapter file plus one registry entry" false,
# and left a dead EVM_DEPOSIT_MOCK_WEBHOOK_SECRET behind when that adapter was
# replaced. Two tests in backend/tests/test_module_boundaries.py now enforce it.
#
# The signature receiving window is part of this: it belongs to whoever owns a
# signing scheme, so there is one per adapter rather than one global
# WEBHOOK_SIGNATURE_TOLERANCE_SECONDS.

# ------------------------------------------------ gnosis_pay_mock (§3.2) -----
# The in-process mock crypto-deposit provider. No credentials: the "provider" is
# a simulator inside this repo, and it signs its own webhooks with a keypair it
# derives from a constant in the code — so there is nothing here to leak.
#
# Rejection window for a delivery's signature timestamp, in seconds, in either
# direction, so a captured delivery cannot be replayed indefinitely.
GNOSIS_PAY_MOCK_SIGNATURE_TOLERANCE_SECONDS=300

# -------------------------------------------------------- lithic (§3.2) -----
# Lithic sandbox. Sign up at lithic.com/signup; the sandbox key is issued with the
# account (app.lithic.com/settings). Leave LITHIC_API_KEY empty and the adapter
# refuses to build — nothing else in the service is affected.
#
# The test suite never calls this API: contract tests replay recorded fixtures in
# backend/tests/fixtures/lithic/, regenerated by
# `python scripts/record_lithic_fixtures.py`.
LITHIC_API_BASE_URL=https://sandbox.lithic.com/v1
LITHIC_API_KEY=

# Per-program webhook signing secret, in Lithic's `whsec_<base64>` form. Obtained
# by creating an event subscription and then reading
# GET /v1/event_subscriptions/{token}/secret. Only needed to accept genuine
# inbound deliveries — signature tests sign their own bodies.
LITHIC_WEBHOOK_SECRET=

# Per-request timeout, in seconds, for calls to Lithic.
LITHIC_REQUEST_TIMEOUT_SECONDS=15.0

# Rejection window for a Lithic delivery's signature timestamp, in seconds.
LITHIC_SIGNATURE_TOLERANCE_SECONDS=300

# ------------------------------------------------ stripe_issuing (§3.2) -----
# Stripe Issuing test mode. Create an account at dashboard.stripe.com, select
# "Card issuing" during onboarding, then activate Issuing
# (dashboard.stripe.com/issuing/overview) — until you do, every /v1/issuing/* call is
# a 400 and nothing else here matters.
#
# Then add test funds to the **Issuing** balance, which is not the payments balance:
# Dashboard -> Issuing -> Balance -> Add funds credits instantly. Via the API,
# `POST /v1/topups` with `destination_balance=issuing` is accepted but stays `pending`
# in test mode, and `/v1/test_helpers/issuing/fund_balance` is for UK/EU
# funding-instruction accounts only. With a zero balance every simulated authorization
# is declined `insufficient_funds`.
#
# `python scripts/record_stripe_fixtures.py --preflight` checks all three and tells you
# which one is missing.
#
# Note the prefix: these are STRIPE_ISSUING_*, not STRIPE_*, because the env prefix
# is the adapter package's own name (app/issuers/stripe_issuing/config.py). A
# future `stripe_connect` adapter would get its own, and neither would read the
# other's variables. backend/tests/test_module_boundaries.py enforces that.
#
# Unlike Lithic, an empty key does not stop the adapter from being built: `GET
# /providers` calls registry.describe(), which instantiates every registered
# adapter, so a missing Stripe key must not take that endpoint down for the
# providers that are configured. The failure happens on the first call that needs
# the key, and names this variable.
#
# The test suite never calls this API. Its fixtures in
# backend/tests/fixtures/stripe_issuing/ are recorded from a real test-mode account by
# `python scripts/record_stripe_fixtures.py`; the README there says which files are
# recorded, which are derived, and which are still authored from documentation.
STRIPE_ISSUING_API_BASE_URL=https://api.stripe.com/v1

# Secret key, from Developers -> API keys. **Must be a test key.** Stripe reads
# test-vs-live from the key rather than from the host, so there is no sandbox URL
# standing between a misconfiguration and real money — the adapter refuses any key
# containing `_live_` outright (SPEC.md §2: sandboxes only).
STRIPE_ISSUING_API_KEY=

# Endpoint signing secret, in Stripe's `whsec_...` form. From a Dashboard webhook
# endpoint, or more easily
# `stripe listen --forward-to localhost:8000/webhooks/stripe_issuing`, which prints
# one for the session. Note that Stripe keys its HMAC on this string *exactly as
# issued*, `whsec_` prefix included — unlike Lithic, which base64-decodes what
# follows the prefix. Leave empty and deliveries are refused rather than trusted.
STRIPE_ISSUING_WEBHOOK_SECRET=

# Pins the `Stripe-Version` header when set; empty means the account's own default.
# Left empty deliberately: the only version-dependent behaviour this adapter cares
# about is whether a lapsed authorization reports `expired` or `reversed`, and it
# treats both as a reversal.
STRIPE_ISSUING_API_VERSION=

# Per-request timeout, in seconds, for calls to Stripe.
STRIPE_ISSUING_REQUEST_TIMEOUT_SECONDS=15.0

# Rejection window for a Stripe delivery's signature timestamp, in seconds.
# Stripe's own libraries default to 300.
STRIPE_ISSUING_SIGNATURE_TOLERANCE_SECONDS=300

# -------------------------------------------------- solana watcher (§5.2) ---
# The deposit watcher. **No credentials**: Solana's devnet RPC is public, and
# everything the watcher does is read-only. Its settings belong to `app/chain/`
# under this prefix, for the same reason each adapter owns its own.
#
# The test suite never calls the RPC. Its fixtures in
# backend/tests/fixtures/solana/ are recorded from devnet by
# `python scripts/record_solana_fixtures.py`; the README there says which are
# recorded and which are derived.

# JSON-RPC endpoint. Defaults to devnet so a misconfigured environment cannot
# reach mainnet by omission. A local validator would be http://127.0.0.1:8899.
SOLANA_RPC_URL=https://api.devnet.solana.com

# The token to watch for. Circle's USDC on devnet; not a credential, an address.
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# USDC's decimals. Configurable because a different mint has different ones, not
# because this one changes. A USD card has two, so 10^(6-2) base units are one
# cent and anything below that cannot be credited.
SOLANA_USDC_DECIMALS=6

# Signatures fetched per poll. The node caps this at 1000; small pages keep one
# poll's work bounded and the cursor moving.
SOLANA_PAGE_LIMIT=25

# Per-request timeout, in seconds, for RPC calls.
SOLANA_REQUEST_TIMEOUT_SECONDS=20.0

# **A devnet keypair, and therefore a secret** — the one value in this section
# that is. SPEC.md §8's "demo deposit keypair": it owns the Solana account the
# watcher polls, and `app/chain/tokens.py` derives that account's address from it
# (a wallet address does not hold USDC; the token account it derives to does).
#
# Optional. Without it the phase-5 demo watches a public devnet account instead,
# which needs nothing. With it, the demo prints the deposit address to send
# devnet USDC to — free from faucet.circle.com, which needs a browser.
#
# Either format works: the JSON array `solana-keygen new -o key.json` writes, or
# the base58 string a wallet exports. Never a mainnet key: nothing here checks,
# because a devnet-only project should not be the thing standing between a
# mainnet key and its use.
SOLANA_DEPOSIT_KEYPAIR=

# ------------------------------------------- simulated bridge (§5.2) --------
# The deterministic stand-in for a cross-chain bridge, and the default for the
# recorded demo — SPEC.md §5.2 keeps it that way even after phase 6 adds a real
# protocol, so a walk-through of the funding pipeline cannot fail because
# somebody else's testnet is down. No credentials: it runs in this process.
#
# Same ownership rule as the issuer adapters: these belong to
# app/chain/bridge/simulated.py under its own prefix, not to app/core/config.py.

# How long a transfer stays in flight, in seconds. Long enough that a demo viewer
# sees the intent sit in BRIDGING rather than flicker through it.
SIMULATED_BRIDGE_LATENCY_SECONDS=3.0

# Bridge fee in integer minor units, deducted from what arrives. Non-zero makes
# the demo show the thing SPEC.md §11 calls out: the card is funded with the
# amount that *landed*, which is not the amount that was deposited.
SIMULATED_BRIDGE_FEE_MINOR=0

# Failure injection, for demonstrating the reconciler (SPEC.md §5.3). One of:
#   none               a bridge that works (the default — failure is never accidental)
#   submit_unavailable the order is refused with a retryable error; nothing accepted
#   submit_rejected    a permanent refusal; the intent fails at once
#   transfer_failed    accepted, then reported FAILED on a later poll
#   stuck              accepted, then silence forever — the reconciler's target
SIMULATED_BRIDGE_FAILURE_MODE=none

# -------------------------------------------- bridge selection (§5.2) -------
# Which BridgeProvider the worker and demo use. `simulated` is the default and
# SPEC.md §5.2 is explicit about why: a recorded walk-through of the pipeline must
# not be able to fail because somebody else's testnet is down. The real adapter is
# opt-in, per run — `--bridge wormhole` on the worker overrides this.
#   simulated  the deterministic stand-in (below)
#   wormhole   the real protocol: Solana devnet -> BSC testnet, lock-and-mint
BRIDGE_PROVIDER=simulated

# ------------------------------------------- Wormhole bridge (§5.2) ---------
# The real bridge adapter (phase 6): Solana devnet -> BSC testnet, lock-and-mint.
# deBridge, which SPEC.md §5.2 names first, has no testnet and cannot have one —
# docs/ARCHITECTURE.md §10.1 has the research. Nothing here is a credential; every
# value is a public program, contract or endpoint, and every default is the route
# that was verified against the chains. Left unset, a live run uses that route.

# The two Solana programs. These are Wormhole's *Testnet* deployment, which for
# Solana means the devnet cluster. Their docs mark Solana ✅ under Testnet and ❌
# under "Devnet" — that second column is Wormhole's own Tilt local network, so
# searching their table for "devnet" finds the wrong answer first.
WORMHOLE_CORE_PROGRAM=3u8hJUVTA4jH1wYAyUur7FFZVQ8H635K3tSHHF4ssjQ5
WORMHOLE_TOKEN_BRIDGE_PROGRAM=DZnkkTmCiFWfYTfT41X3Rd1kDgozqzxWaHqsw6W4x2oe

# The Token Bridge on the destination chain — where a transfer is redeemed.
WORMHOLE_DESTINATION_TOKEN_BRIDGE=0x9dcF9D205C9De35334D646BeE44b2D2859712A09

# Wormholescan, which serves guardian-signed VAAs over plain HTTP. That is what
# makes this integration possible from Python at all: the SDK is TypeScript only.
WORMHOLE_API_URL=https://api.testnet.wormholescan.io

# Wormhole chain ids, which are NOT EVM chain ids: 1 is Solana, 4 is BSC. These
# are what a VAA carries, so they are what a transfer is addressed with.
WORMHOLE_SOURCE_CHAIN_ID=1
WORMHOLE_DESTINATION_CHAIN_ID=4

WORMHOLE_REQUEST_TIMEOUT_SECONDS=20.0

# ------------------------------------- EVM destination chain (§5.2) ---------
# The chain we redeem on, separate from the protocol above so that pointing this
# at a different EVM testnet touches only this block. Defaults are BSC testnet.

# Public and keyless, and rate-limits as readily as the public Solana devnet
# endpoint does.
EVM_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# EIP-155 chain id, signed into every transaction: a wrong one is rejected by the
# node rather than sent somewhere unintended. 97 is BSC testnet.
EVM_CHAIN_ID=97

# SECRET. Pays gas to submit a redemption on the destination chain. It never holds
# the funds — a Wormhole transfer credits the recipient encoded in the VAA, no
# matter who submits it — so this needs test BNB and nothing else. A testnet key
# only; leave empty and the redeemer refuses to build rather than inventing one.
EVM_REDEEMER_PRIVATE_KEY=

EVM_REQUEST_TIMEOUT_SECONDS=20.0

# How long to wait for a redemption's receipt before reporting the transfer as
# still in flight. Elapsing is not a failure: the transaction may yet be mined,
# and the next status poll asks again.
EVM_RECEIPT_TIMEOUT_SECONDS=120.0

# ------------------------------------------------------ docker-compose ------
# Consumed by docker-compose.yml interpolation, not by the app.
POSTGRES_USER=stablecard
POSTGRES_PASSWORD=stablecard
POSTGRES_DB=stablecard
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
BACKEND_HOST_PORT=8000
