# StableCard Rail — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Phases 1-2 use the "core", "webhooks" and "issuers" sections. Later phases
# append their own (Lithic, Stripe, Solana, bridge, Fireblocks) — each variable is
# documented here before it is read anywhere in the code.

# ---------------------------------------------------------------- core ------
# Free-form deployment label; used for log context only.
ENVIRONMENT=local

# SQLAlchemy async URL for the application database.
# Host port 5442 is what docker-compose publishes (5432 is often taken locally).
DATABASE_URL=postgresql+asyncpg://stablecard:stablecard@localhost:5442/stablecard

# Database used by the test suite. Created automatically by tests if absent.
# Must NOT point at the application database — the suite truncates tables.
TEST_DATABASE_URL=postgresql+asyncpg://stablecard:stablecard@localhost:5442/stablecard_test

# Redis: webhook dedup claims, the handler retry queue, the EventBus stream, and
# from phase 7 OTP codes.
REDIS_URL=redis://localhost:6389/0

# Redis database used by the test suite. The suite FLUSHES this database, so it
# must never point at the application's. Derived from REDIS_URL (db 15) if unset.
TEST_REDIS_URL=redis://localhost:6389/15

# Python logging level for the backend.
LOG_LEVEL=INFO

# ISO-4217 currency assumed when a caller does not specify one.
DEFAULT_CURRENCY=USD

# ------------------------------------------------------------ webhooks ------
# How long a (provider_id, event_id) dedup claim is kept in Redis. The ledger's
# unique index takes over once it expires, so this is a cache size, not a
# correctness knob. Default: 86400 (one day).
WEBHOOK_DEDUP_TTL_SECONDS=86400

# Rejection window for a delivery's signature timestamp, in seconds, in either
# direction — so a captured delivery cannot be replayed indefinitely.
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# Delay before each successive handler retry, as a JSON list. Its length is the
# retry cap: a handler that exhausts it is dead-lettered.
WEBHOOK_RETRY_BACKOFF_SECONDS=[2,8,32,128,512]

# ------------------------------------------------------------- issuers ------
# HMAC key the in-process mock provider signs its own webhooks with. This is not
# a credential to anything: the "provider" is a simulator inside this repo, so a
# value in this file is not a leaked secret. Real adapter keys (Lithic, Stripe;
# phases 3 and 4) will have no defaults and no example values.
EVM_DEPOSIT_MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret-not-a-credential

# ------------------------------------------------------ docker-compose ------
# Consumed by docker-compose.yml interpolation, not by the app.
POSTGRES_USER=stablecard
POSTGRES_PASSWORD=stablecard
POSTGRES_DB=stablecard
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
BACKEND_HOST_PORT=8000
